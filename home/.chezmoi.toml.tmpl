{{- /* Asked once on `chezmoi init`; answers are kept in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name := promptStringOnce . "name" "Git user.name" -}}
{{- $email := promptStringOnce . "email" "Git user.email" -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "work") -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}
